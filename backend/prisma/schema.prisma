generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Auto {
  id          Int      @id @default(autoincrement())
  marca       String
  modelo      String
  anio        Int      @map("año")
  kilometraje Int
  urlImagen   String[]
  patente     String   @unique
  precio      Float
  creadoEn    DateTime @default(now())
  descripcion String?

  @@map("autos")
}
