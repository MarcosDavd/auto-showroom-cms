// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}
// Definición de tu modelo (Equivalente al model.py de SQLAlchemy)
model Auto {
  id          Int      @id @default(autoincrement())
  marca       String
  modelo      String
  anio        Int      @map("año") // Usamos "anio" en el código para evitar la 'ñ', pero mapeado a la DB
  kilometraje Int
  urlImagen   String[] // Arreglo de strings para guardar múltiples URLs de imágenes
  patente     String   @unique // La patente debe ser única
  precio      Float
  creadoEn    DateTime @default(now())

  @@map("autos")
}
datasource db {
  provider = "postgresql"
}
